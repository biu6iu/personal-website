---
import type { Project } from '../data/projects.ts';
import TimelineRow from './TimelineRow.astro';
import SectionLink from './SectionLink.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<TimelineRow date={project.date} title={project.title}>
  <p>{project.summary}</p>
  {project.bullets.map((bullet) => <p> • {bullet}</p>)}
  {project.links.map((link) => (
    <p> • {link.label} <SectionLink href={link.href} text={link.text} /></p>
  ))}
</TimelineRow>
