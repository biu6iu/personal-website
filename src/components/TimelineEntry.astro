---
import type { TimelineEntry } from '../data/timeline.ts';
import TimelineRow from './TimelineRow.astro';
import SectionLink from './SectionLink.astro';

interface Props {
  entry: TimelineEntry;
  /** Prefixes each line with the same " • " marker project cards use. */
  bulleted?: boolean;
}

const { entry, bulleted = false } = Astro.props;
const marker = bulleted ? ' • ' : '';
---

<TimelineRow date={entry.date} title={entry.title}>
  {entry.lines.map((line) =>
    'text' in line ? (
      <p>{marker}{line.text}</p>
    ) : (
      <p>
        {marker}{line.prefix}
        {line.links.map((link, i) => (
          <Fragment>
            {i > 0 ? ', ' : ' '}
            <SectionLink href={link.href} text={link.text} />
          </Fragment>
        ))}
      </p>
    )
  )}
</TimelineRow>
