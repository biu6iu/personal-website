---
import type { Collection } from '../data/collections.ts';

interface Props {
  collection: Collection;
}

const { collection } = Astro.props;

const slug = collection.path.replace(/\.html$/, '');
const href = `${import.meta.env.BASE_URL}collections/${slug}`;
---

<a href={href}>
  <button class="border-0 bg-transparent p-0 cursor-pointer transition-[transform,background-color,color] duration-300 ease-[ease] hover:scale-97">
    <img
      src={collection.coverImage}
      alt={collection.title}
      class="w-full h-auto max-w-[525px] max-md:max-w-full max-h-[525px] object-cover"
    />
  </button>
</a>
