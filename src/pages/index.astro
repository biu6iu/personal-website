---
import Layout from '../layouts/Layout.astro';
import { COLLECTIONS } from '../data/collections.ts';


const SLIDE_INTERVAL = 2500;
---

<Layout title="Home page">
  <div id="photo-slideshow" class="slideshow" data-interval={SLIDE_INTERVAL}>
    {COLLECTIONS.map((collection, i) => (
      <img
        src={collection.coverImage}
        alt={collection.title}
        class={i === 0 ? 'active' : undefined}
      />
    ))}
  </div>
</Layout>

<script>
  const slideshow = document.getElementById('photo-slideshow');

  if (slideshow) {
    const images = Array.from(slideshow.getElementsByTagName('img'));
    const interval = Number(slideshow.dataset.interval) || 2500;
    let current = 0;

    if (images.length > 1) {
      setInterval(() => {
        images[current].classList.remove('active');
        current = (current + 1) % images.length;
        images[current].classList.add('active');
      }, interval);
    }
  }
</script>
